------------------------------------------------------------------ aiming
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function getAimPart(character)
	if settings.targetPart == "Head" then
		return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	end
	return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

-- true when nothing solid is between the camera and the target
local function isVisible(origin, part, character)
	local mine = player.Character
	rayParams.FilterDescendantsInstances = mine and { mine } or {}
	local result = workspace:Raycast(origin, part.Position - origin, rayParams)
	return result == nil or result.Instance:IsDescendantOf(character)
end

local function findTarget(cam)
	local center = cam.ViewportSize / 2
	local origin = cam.CFrame.Position
	local best, bestDist = nil, settings.fov

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local char = other.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local sameTeam = settings.teamCheck and player.Team ~= nil and other.Team == player.Team
			if hum and hum.Health > 0 and not sameTeam then
				local part = getAimPart(char)
				if part and (part.Position - origin).Magnitude <= settings.maxDistance then
					local screen, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen then
						local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
						if dist <= bestDist and (not settings.wallCheck or isVisible(origin, part, char)) then
							best, bestDist = part, dist
						end
					end
				end
			end
		end
	end
	return best
end

RunService:BindToRenderStep("AimAssist", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	local active = settings.enabled and cam ~= nil

	fovCircle.Visible = active and settings.showFov
	fovCircle.Size = UDim2.fromOffset(settings.fov * 2, settings.fov * 2)
	fovStroke.Color = WHITE

	if not active then
		return
	end
	if settings.holdToAim and not state.aiming then
		return
	end

	local target = findTarget(cam)
	if target then
		fovStroke.Color = GREEN
		local goal = CFrame.lookAt(cam.CFrame.Position, target.Position)
		if settings.instant then
			cam.CFrame = goal -- snap straight onto the target
		else
			local alpha = 1 - math.exp(-settings.strength * dt)
			cam.CFrame = cam.CFrame:Lerp(goal, alpha)
		end
	end
end)
