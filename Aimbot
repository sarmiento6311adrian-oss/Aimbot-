--[[
  AimAssistClient  (put in StarterPlayer > StarterPlayerScripts as a LocalScript)

  Aim assist for your own game: menu, wall check, team check, FOV circle, smoothing.

  Menu:  tap the AIM button on the left, or press RightShift.
  Aim:   hold Right Mouse (PC) or the AIM HOLD button (mobile).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

------------------------------------------------------------------ settings
local MENU_KEY = Enum.KeyCode.RightShift

local settings = {
	enabled = true,
	holdToAim = true,   -- off = aims by itself whenever someone is inside the FOV
	wallCheck = true,   -- ignore targets behind walls
	teamCheck = true,   -- ignore teammates
	showFov = true,
	fov = 150,          -- FOV circle radius in pixels
	instant = true,     -- snap straight onto the target (off = smooth, uses Strength)
	strength = 12,      -- how fast the camera turns to the target when Instant is off
	maxDistance = 500,  -- studs
	targetPart = "Head", -- "Head" or "Body"
}

local state = { aiming = false }

