local function addToggle(label, key)
	local row = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = ROW,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = nextOrder(),
	}, body)
	corner(row)
	make("TextLabel", {
		Size = UDim2.new(1, -60, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 14,
	}, row)
	local pill = make("Frame", {
		Size = UDim2.fromOffset(38, 18),
		Position = UDim2.new(1, -48, 0.5, -9),
		BorderSizePixel = 0,
	}, row)
	corner(pill, 9)
	local knob = make("Frame", {
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, pill)
	corner(knob, 7)
	local function paint()
		local on = settings[key]
		pill.BackgroundColor3 = on and ACCENT or OFF
		knob.Position = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
	end
	row.Activated:Connect(function()
		settings[key] = not settings[key]
		paint()
	end)
	paint()
end

local activeSlider = nil -- function that updates the slider being dragged

local function addSlider(label, key, min, max, step)
	local row = make("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = ROW,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(),
	}, body)
	corner(row)
	local text = make("TextLabel", {
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.fromOffset(10, 3),
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		Text = "",
	}, row)
	local track = make("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 0, 32),
		BackgroundColor3 = OFF,
		BorderSizePixel = 0,
	}, row)
	corner(track, 3)
	local fill = make("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = ACCENT,
		BorderSizePixel = 0,
	}, track)
	corner(fill, 3)
	-- bigger invisible touch target over the thin track
	local hit = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 0.5, -12),
		BackgroundTransparency = 1,
		Text = "",
	}, track)

	local function setFromAlpha(a)
		a = math.clamp(a, 0, 1)
		local v = min + (max - min) * a
		v = math.floor(v / step + 0.5) * step
		settings[key] = v
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		text.Text = label .. ": " .. tostring(v)
	end
	local function fromInput(input)
		setFromAlpha((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
	end

	setFromAlpha((settings[key] - min) / (max - min))
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = fromInput
			body.ScrollingEnabled = false -- so dragging a slider doesn't scroll the menu
			fromInput(input)
		end
	end)
end

local function addCycle(label, key, options)
	local btn = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = ROW,
		BorderSizePixel = 0,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		LayoutOrder = nextOrder(),
	}, body)
	corner(btn)
	make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, btn)
	local function paint()
		btn.Text = label .. ": " .. tostring(settings[key])
	end
	btn.Activated:Connect(function()
		local idx = table.find(options, settings[key]) or 0
		settings[key] = options[idx % #options + 1]
		paint()
	end)
	paint()
end

