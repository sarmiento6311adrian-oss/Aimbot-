local PANEL = Color3.fromRGB(24, 24, 30)
local ROW = Color3.fromRGB(38, 38, 48)
local OFF = Color3.fromRGB(70, 70, 84)
local ACCENT = Color3.fromRGB(90, 170, 255)
local TEXT = Color3.fromRGB(235, 235, 245)
local WHITE = Color3.new(1, 1, 1)
local GREEN = Color3.fromRGB(80, 255, 130)

local function make(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

